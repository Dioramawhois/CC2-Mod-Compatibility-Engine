{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cc2-mce:package:2",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "engine_sha256",
    "game_sha256",
    "mod_order",
    "sources",
    "files",
    "blockers",
    "eol_policy",
    "toolchain_sha256",
    "runtime_sha256",
    "installable",
    "gameplay_verified",
    "build_id",
    "package_metadata_sha256"
  ],
  "properties": {
    "managed_menu": {
      "type": "object",
      "required": ["policy", "logical_path", "input_sha256", "adapter_sha256", "output_sha256"],
      "additionalProperties": false,
      "properties": {
        "policy": {"const": "read-only-mod-list-v1"},
        "logical_path": {"type": "string"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "adapter_sha256": {"$ref": "#/$defs/hash"},
        "output_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "config_defaults": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["filename", "sha256", "providers", "policy"],
        "properties": {
          "filename": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*\\.ini$"},
          "sha256": {"$ref": "#/$defs/hash"},
          "providers": {"type": "array", "items": {"$ref": "#/$defs/hash"}},
          "policy": {"const": "create-missing-preserve-user"}
        }
      }
    },
    "modules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["source_id", "owner_id", "container", "source_sha256", "manifest_sha256"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string"},
          "owner_id": {"type": "string", "maxLength": 64},
          "container": {"type": "string", "pattern": "^m-[0-9a-f]{32}$"},
          "source_sha256": {"$ref": "#/$defs/hash"},
          "manifest_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "schema_version": {
      "const": 2
    },
    "owner": {
      "const": "cc2-mce"
    },
    "output_folder": {
      "const": "CC2-MCE"
    },
    "merge_policy": {
      "enum": ["strict", "ordered-patches"]
    },
    "engine_sha256": {
      "$ref": "#/$defs/hash"
    },
    "game_sha256": {
      "$ref": "#/$defs/hash"
    },
    "build_id": {
      "$ref": "#/$defs/hash"
    },
    "mod_order": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sha256",
          "files",
          "package_kind",
          "dependencies"
        ],
        "properties": {
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "logical_path",
          "status",
          "strategy",
          "source_sha256",
          "baseline_sha256",
          "output_sha256",
          "diagnostics"
        ],
        "properties": {
          "logical_path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "strategy": {
            "type": "string"
          },
          "source_sha256": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/hash"
            }
          },
          "baseline_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline_source": {
            "type": ["string", "null"]
          },
          "output_sha256": {
            "anyOf": [
              {
                "$ref": "#/$defs/hash"
              },
              {
                "type": "null"
              }
            ]
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code"
        ]
      }
    },
    "eol_policy": {
      "const": "canonical-lf-for-three-way; unique-files-preserved"
    },
    "toolchain_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_review": {
      "type": "object",
      "required": ["stage", "source_commit", "verified_scope", "unverified_scope", "multiplayer_verified", "dedicated_verified"],
      "properties": {
        "stage": {"const": "client-candidate"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runtime_version": {"type": "string", "maxLength": 64},
        "source_url": {"type": "string", "maxLength": 512},
        "verified_scope": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
        "unverified_scope": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}},
        "multiplayer_verified": {"const": false},
        "dedicated_verified": {"const": false},
        "evidence_log_sha256": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "runtime_inputs": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "runtime_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/hash"
        },
        {
          "type": "null"
        }
      ]
    },
    "installable": {
      "type": "boolean"
    },
    "gameplay_verified": {
      "type": "boolean"
    },
    "package_metadata_sha256": {
      "$ref": "#/$defs/hash"
    }
  },
  "if": {
    "properties": {
      "blockers": {
        "minItems": 1
      }
    }
  },
  "then": {
    "properties": {
      "installable": {
        "const": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
